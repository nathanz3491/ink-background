{
  "name": "@nathanzhou/ink-background",
  "version": "0.1.0",
  "description": "A living WebGL background: ink marbling in paper-coloured water. Vanilla JS and React.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Nathan Zhou (https://nathanz.cloud)",
  "homepage": "https://nathanz.cloud",
  "repository": { "type": "git", "url": "git+https://github.com/nathanz3491/ink-background.git" },
  "bugs": "https://github.com/nathanz3491/ink-background/issues",
  "keywords": [
    "background",
    "webgl",
    "shader",
    "ink",
    "marble",
    "fluid",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "example": "npm run build && npx --yes serve -l 4173 .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^9.0.0",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  }
}
